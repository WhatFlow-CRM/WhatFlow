generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Plan {
  id               String   @id @default(cuid())
  planType         String   @unique
  displayName      String
  monthlyPrice     Float
  annualPrice      Float
  dailyMessageLimit Int    @default(500)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model User {
  id              String   @id @default(cuid())
  whatsappNumber  String   @unique
  name            String?
  email           String?
  planType        String   @default("FreeTrial")
  isActive        Boolean  @default(false)
  currentKeyId    String?  @unique
  activatedAt     DateTime?
  expiresAt       DateTime?
  lastPlanType    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ActivationKey {
  id              String   @id @default(cuid())
  key             String   @unique
  planType        String
  durationDays    Int
  status          String   @default("unused")
  linkedNumber    String?  @unique
  activatedAt     DateTime?
  expiresAt       DateTime?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Feature {
  id          String   @id @default(cuid())
  featureKey  String   @unique
  displayName String
  description String?
  isActive    Boolean  @default(true)
  planAccess  PlanFeatureAccess[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlanFeatureAccess {
  id         String  @id @default(cuid())
  planType   String
  featureKey String
  isEnabled  Boolean @default(false)
  feature    Feature @relation(fields: [featureKey], references: [featureKey])
  @@unique([planType, featureKey])
}

model FeatureOverride {
  id         String  @id @default(cuid())
  userId     String
  featureKey String
  isEnabled  Boolean @default(true)
  createdAt  DateTime @default(now())
  @@unique([userId, featureKey])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model SystemConfig {
  id        String @id @default(cuid())
  key       String @unique
  value     String
  updatedAt DateTime @updatedAt
}
